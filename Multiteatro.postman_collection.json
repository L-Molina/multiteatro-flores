{
  "info": {
    "name": "Multiteatro API",
    "description": "Cheat sheet Postman - Multiteatro. Login primero: guarda el token en la variable {{token}} (automatica). Teatros/Salas seed: t1,t2 | Salas:1,2 | Obras:1,2 | TipoAsiento:1,2 | Funciones:1,2,3 | Asientos libres func1: 4,6,8,9,10,11. Usuarios: superadmin@multiteatroflores.com/superadmin123 (SUPERADMIN) | marta@teatrolanus.com/admin123 (ADMIN t1) | lautaro@example.com/cliente123 (CLIENTE).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0) Auth (sin token)",
      "item": [
        {
          "name": "Login SUPERADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Devuelve {token, usuario}. Copia el token a la variable {{token}} de la coleccion. Requiere Content-Type: application/json.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@multiteatroflores.com\",\n  \"password\": \"superadmin123\"\n}"
            },
            "options": {
              "raw": {
                "language": "json"
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);",
                  "console.log('token guardado:', j.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
